# Kopieren nach .env und anpassen. .env wird nicht eingecheckt.

# --- Entwicklung (lokal) ---------------------------------------------------
DEBUG=True
# SITE_NAME=Geräteinventar
# SITE_URL=http://localhost:8000

# --- Betrieb (Server) ------------------------------------------------------
# DEBUG=False
# SECRET_KEY=<langer zufälliger Wert, z. B. python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=inventar.example.org
# CSRF_TRUSTED_ORIGINS=https://inventar.example.org
# SITE_URL=https://inventar.example.org
# POSTGRES_PASSWORD=<Datenbank-Passwort, wird von compose.yaml genutzt>
# DATABASE_URL=postgres://inventar:<passwort>@db:5432/inventar   (setzt compose.yaml automatisch)

# E-Mail (Sonderzeichen im Passwort URL-kodieren, z. B. @ -> %40)
# EMAIL_URL=smtp+tls://benutzer:passwort@smtp.example.org:587
# DEFAULT_FROM_EMAIL=Geräteinventar <inventar@example.org>

# HTTPS hinter Reverse-Proxy (Standardwerte bei DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Ausleihe & Erinnerungen
# DEFAULT_LOAN_DAYS=7
# REMINDER_OVERDUE_INTERVAL_DAYS=2
# REMINDER_PENDING_REQUEST_DAYS=2
# MAX_PHOTO_UPLOAD_MB=25
# MAX_DOCUMENT_UPLOAD_MB=100

# KI-Suche: neuen OpenRouter-Schlüssel mit einem Limit von 10 USD/Monat verwenden.
# OPENROUTER_API_KEY=<neuer Schlüssel, niemals einchecken>
# ASSISTANT_MODEL=openai/gpt-6-luna
# ASSISTANT_WEB_SEARCH=True
# ASSISTANT_REQUESTS_PER_HOUR=20
